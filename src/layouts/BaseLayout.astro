---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { SCHEME_COLORS } from '../lib/theme';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ? new URL(base, Astro.site) : undefined;
const pageUrl = new URL(base, siteUrl ?? 'https://BRAYANPISSO02.github.io');

/**
 * Absolute share-image URL, base-aware.
 *
 * `og:image` must be absolute HTTPS: a share crawler fetches it from its own
 * server, with no document to resolve a relative path against. Building it
 * from `pageUrl` means it carries the project base
 * (`https://brayanpisso02.github.io/PageBrayanPissoCV/og.jpg`), which is what
 * makes it resolve on GitHub Pages and not only on a dev server.
 *
 * Dimensions and MIME type are the committed `public/og.jpg` as measured, not
 * aspirational: 1200x630 JPEG, generated by `scripts/generate-og-image.mjs`.
 */
const ogImage = new URL('og.jpg', pageUrl);

/**
 * Name parts as OpenGraph wants them.
 *
 * The layout is the only place that has to reconcile three different shapes of
 * the same name: `SITE.fullName` for humans, schema.org `givenName` /
 * `familyName` for structured data, and the OpenGraph `profile:*` pair, which
 * wants a single given name and a single family name. Splitting the existing
 * parts here keeps one authored source. Deriving them from `SITE.fullName`
 * instead of re-typing literals means the structured data cannot drift away
 * from the visible name.
 *
 * The Spanish two-surname convention (`Pisso Ramírez`) is the reason the
 * family part is a phrase while `profile:last_name` is a single token.
 */
const givenName = 'Brayan Ricardo';
const familyName = 'Pisso Ramírez';
const firstName = givenName.split(' ')[0];

/** Last path segment of the GitHub URL, so it cannot drift from the link. */
const githubHandle = SITE.github.split('/').filter(Boolean).pop() ?? '';

/**
 * No `description` on purpose. The prose summary already ships as the meta
 * description, and the OpenGraph and Twitter cards each repeat it from the
 * same prop, so a fourth copy here would put the same sentence in the head
 * three times over. This node carries facts instead: role, name, languages,
 * contact, affiliation, and the `sameAs` links that identify the person.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': pageUrl.toString(),
  name: SITE.fullName,
  givenName,
  familyName,
  jobTitle: SITE.title,
  /** schema.org `Person.email` takes a bare address, never a `mailto:` URI. */
  email: SITE.email,
  telephone: SITE.phoneDisplay.replace(/\s/g, ''),
  url: pageUrl.toString(),
  knowsLanguage: ['es', 'en'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Manizales',
    addressRegion: 'Caldas',
    addressCountry: 'CO',
  },
  sameAs: [SITE.linkedin, SITE.github],
  alumniOf: ['Universidad Nacional de Colombia', 'Servicio Nacional de Aprendizaje (SENA)'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!--
      Both schemes are declared, and each `theme-color` is bound to its scheme
      by `media`. Declaring the scheme without the pair would leave the browser
      chrome pinned to one scheme while the page renders both, so the two
      always ship together. No JavaScript touches either value.
    -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={SCHEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SCHEME_COLORS.dark} media="(prefers-color-scheme: dark)" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="canonical" href={pageUrl.toString()} />

    <!--
      Open Graph. Every tag below uses `property=`, never `name=`: the spec
      defines OG properties as RDF predicates, and scrapers that only look at
      `name=` ignore them.

      `og:type` is `profile` because the page is a person, and the three
      profile properties a real page can answer for are emitted. The gender
      property is deliberately absent: the spec lists it as available, not
      required, and there is no honest value to put there. Omitting it does
      not violate the spec; inventing one would.

      No separate image property under `twitter:`: X falls back to `og:image`,
      and a second copy of the same URL is one more thing to keep in sync.
    -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.toString()} />
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={familyName.split(' ')[0]} />
    <meta property="profile:username" content={githubHandle} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:image:secure_url" content={ogImage.toString()} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Brayan Pisso — Machine Learning Engineer. Computer vision models built with PyTorch and Amazon SageMaker, based in Manizales, Colombia."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>