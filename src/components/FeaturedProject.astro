---
import Icon from './Icon.astro';
import { FEATURED_PROJECT } from '../lib/site';

const { title, org, period, tags, case: caseStudy } = FEATURED_PROJECT;
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Featured Project</p>
      <h2 id="projects-title" class="section-title">A case study, end to end</h2>
    </div>

    <article class="panel-dark" data-reveal>
      <div class="panel-inner">
        <p class="eyebrow eyebrow--light">
          <Icon name="chip" size={15} strokeWidth={1.9} />
          Flagship · {org} · {period}
        </p>
        <h3 class="section-title" style="color: var(--dark-ink)">{title}</h3>

        <ul class="entry-tags" aria-label="Technologies">
          {tags.map((tag) => <li><span class="chip" style="border-color: var(--dark-line-strong); background: rgba(255,255,255,.05); color: var(--dark-ink-2)">{tag}</span></li>)}
        </ul>

        <p class="featured-summary">{FEATURED_PROJECT.summary}</p>

        <div class="case-grid">
          <div class="case-cell">
            <p class="case-index">01 — Problem</p>
            <p class="case-title">Manual design is the bottleneck</p>
            <p class="case-text">{caseStudy.problem}</p>
          </div>
          <div class="case-cell">
            <p class="case-index">02 — Solution</p>
            <p class="case-title">Automated computer vision pipeline</p>
            <p class="case-text">{caseStudy.solution}</p>
          </div>
          <div class="case-cell">
            <p class="case-index">03 — Technology</p>
            <p class="case-title">PyTorch · SAM · Amazon SageMaker</p>
            <p class="case-text">{caseStudy.technology}</p>
          </div>
          <div class="case-cell case-cell--impact">
            <p class="case-index">04 — Impact</p>
            <p class="case-impact-value"><span>≈ 2 h</span> / image</p>
            <p class="case-text">{caseStudy.impact}</p>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>