---
import Icon from './Icon.astro';
import { NAV_LINKS, CV_URL } from '../lib/site';
import { CV_AVAILABLE } from '../lib/cv';

const desktopLinks = NAV_LINKS.filter((link) => link.desktop !== false);
---

<header class="site-header" data-nav>
  <div class="container nav">
    <a class="brand" href="#home" aria-label="Back to top — Brayan Pisso">
      <span class="brand-mark" aria-hidden="true"></span>
      BRAYAN PISSO
    </a>

    <nav aria-label="Primary">
      <ul class="nav-desktop">
        {
          desktopLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        {
          CV_AVAILABLE && (
            <li>
              <a class="nav-cta" href={CV_URL} download>
                <Icon name="download" size={15} strokeWidth={2.2} />
                CV
              </a>
            </li>
          )
        }
      </ul>
    </nav>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="nav-mobile" aria-label="Open menu">
      <Icon name="menu" size={20} strokeWidth={2} />
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden>
    <div class="container">
      <nav aria-label="Primary mobile">
        <ul>
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
          {
            CV_AVAILABLE && (
              <li>
                <a class="nav-mobile-cta" href={CV_URL} download>
                  <Icon name="download" size={16} strokeWidth={2.2} />
                  Download CV (PDF)
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
</header>